results %>%
filter(bonus %in% TRUE, !is.na(correct)) %>%
summarise(correct = sum(correct), total = n(), pct = round(100 * correct / total, 1))
results %>%
filter(!is.na(correct)) %>%
group_by(user, bonus = ifelse(bonus %in% TRUE, "Bonus", "Regular")) %>%
summarise(pct = round(100 * mean(correct), 1), n = n(), .groups = "drop") %>%
tidyr::pivot_wider(names_from = bonus, values_from = c(pct, n))
